{
  "name": "quill",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Quill: an AI trading desk with a checkpoint. Ask in plain words, review the checks, sign in your own wallet.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "dev": "node --watch-path=src --watch-path=server.mjs server.mjs",
    "mock": "QUILL_MOCK=1 node server.mjs",
    "test": "QUILL_MOCK=1 node --test test/*.test.mjs",
    "token": "node scripts/token.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
