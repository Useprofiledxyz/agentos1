# Copy to .env and run: node --env-file=.env server.mjs

# AI chat (Claude). Without it, the chat runs a deterministic command parser.
ANTHROPIC_API_KEY=
# QUILL_MODEL=claude-opus-5-5
# QUILL_EFFORT=medium

# Signs sessions and tickets. Required on Vercel (all instances must share it): openssl rand -hex 32
QUILL_SECRET=

# Server
# PORT=9330
# HOST=127.0.0.1
# TRUST_PROXY=1        # behind a reverse proxy: read the client IP from X-Forwarded-For
# COOKIE_SECURE=1      # serving over HTTPS
# QUILL_DATA=./data    # where policy, limits, journal and API token hashes live

# Offline demo: simulated quotes and chain reads. Never use for real trades.
# QUILL_MOCK=1

# RPC and venue overrides
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# BASE_RPC=https://mainnet.base.org
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
# HL_INFO_URL=https://api.hyperliquid.xyz/info
# KYBER_CLIENT_ID=quill
# KYBER_ROUTERS=0x6131B5fae19EA4f9D964eAc0408E4408b66337b5
